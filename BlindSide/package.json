{
  "name": "blindside",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "emulators": "firebase emulators:start --project demo-blindside",
    "seed:firestore": "node scripts/seed-firestore.cjs",
    "seed:firestore:dry-run": "node scripts/seed-firestore.cjs --dry-run",
    "seed:firestore:production": "node scripts/seed-firestore.cjs --production",
    "seed:firestore:verify": "node scripts/verify-firestore-seed.cjs",
    "test:jigsaw": "node --test tests/jigsaw.test.cjs",
    "test:models": "node --test tests/models.test.cjs",
    "test:auth": "node --test tests/auth.service.test.cjs",
    "test:firebase": "firebase emulators:exec --only firestore --project demo-blindside \"node --test tests/jigsaw.test.cjs tests/models.test.cjs tests/auth.service.test.cjs tests/firestore.rules.test.cjs\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~54.0.35",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-screen-orientation": "~9.0.9",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.26.0"
  }
}
